{
	"schemaVersion": 1,
	"id": "resourcepack-priorizer",
	"version": "${version}",
	"name": "ResourcePack Priorizer",
	"description": "Client-side control over resource pack priority. Lets your local resource packs override the pack a server sends, without disabling, blocking or modifying the server pack.",
	"authors": [
		"dxkr"
	],
	"contact": {
		"homepage": "https://github.com/uDxkr/Resourcepack-priority",
		"sources": "https://github.com/uDxkr/Resourcepack-priority",
		"issues": "https://github.com/uDxkr/Resourcepack-priority/issues"
	},
	"license": "CC0-1.0",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.github.udxkr.packpriority.PackPriorityMod"
		]
	},
	"mixins": [
		{
			"config": "resourcepack-priorizer.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
